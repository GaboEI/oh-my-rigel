{
  "schemaVersion": 1,
  "profile": "gabo",
  "platform": {
    "opencode": ">=2.0.19",
    "installation": "manual-after-isolated-acceptance"
  },
  "requiredPlugins": [
    "opencode-go-multi-auth",
    "oc-codex-multi-auth",
    "opencode-model-filters-v2",
    "context-mode",
    "local.goal-mode.server",
    "opencode-warp",
    "auto_approve_keybind.mjs"
  ],
  "optionalPlugins": [
    "kdco-primitives",
    "kkcode.notify",
    "whisperopencode-push"
  ],
  "mcpPolicy": {
    "websearch": "tavily",
    "context7": "external-singleton",
    "playwright": "external-singleton",
    "bundledLocal": ["ssh"],
    "coreExternalConnections": ["context7", "playwright", "obsidian"],
    "optIn": ["docker", "github", "postgres"],
    "optInSecurity": ["tide"],
    "excluded": ["openrouter"],
    "omoBuiltinsRetained": ["grep_app", "lsp", "context7"],
    "omoBuiltinsDisabled": [],
    "externalConfigurationRequired": ["context7", "playwright", "obsidian"],
    "externalEnvKeys": { "obsidian": "OBSIDIAN_API_KEY" },
    "externalEndpoints": { "obsidian": "https://127.0.0.1:27124/mcp/" },
    "bundledSupplyChain": {
      "ssh": {
        "package": "@hypnosis/ssh-mcp-server",
        "version": "2.3.3",
        "license": "MIT",
        "integrity": "sha512-SzUHJ4cMJueGpSMYC3cBllkUYPz1QkBtKcJgRHIATGxuviQ8fDBNvcf1ec0GK5Ti39+9bXH+qnvJSC7K9GKQ9g==",
        "offlineNote": "npx resolves this pinned version from the npm registry and caches it; the first use requires network. Pinned-reproducible, not offline-reproducible."
      }
    }
  },
  "skillPolicy": {
    "bundled": ["prompt-master", "juez-tester", "juez-repo", "github-public-writing", "opencode-multi-auth-fix", "defuddle", "obsidian-vault-writing-rules", "obsidian-second-brain-audit", "obsidian-cli", "obsidian-markdown", "obsidian-bases", "json-canvas", "tui-design", "skill-creator", "team-mode"],
    "gaboCore": ["prompt-master", "juez-tester", "juez-repo"],
    "gaboAvailable": ["github-public-writing", "obsidian-vault-writing-rules", "obsidian-second-brain-audit", "obsidian-markdown", "obsidian-cli", "obsidian-bases", "json-canvas", "tui-design", "skill-creator", "opencode-multi-auth-fix", "defuddle", "team-mode"],
    "omoAdopt": ["debugging", "frontend", "git-master", "remove-ai-slops", "security-research", "visual-qa", "team-mode"],
    "omoAdapt": ["playwright", "review-work", "init-deep", "ulw-plan", "ulw-research", "ulw-execute"],
    "omoProgressive": ["ast-grep", "coding-agent-sessions", "data-scientist", "lsp-setup", "programming", "refactor"],
    "omoDisabled": ["dev-browser", "ultimate-browsing"],
    "projectAligned": ["hyperplan", "security-research"],
    "projectLocalExcluded": ["watchdogvpn-session-start", "watchdogvpn-standing-rules", "watchdogvpn-task-closure"]
  },
  "rootAuthorities": {
    "orchestrator": "sisyphus",
    "orchestrationContract": "sisyphus",
    "acceptance": "judge",
    "goalContinuation": "local.goal-mode.server",
    "contextCompaction": "context-mode"
  },
  "nonGoals": [
    "copy WatchdogVPN skills or commands",
    "install into the active OpenCode configuration",
    "store credentials, accounts, hosts, or database connections"
  ]
}
