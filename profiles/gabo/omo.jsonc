{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "profiles": {
    "gabo": {
      "[opencode]": {
        "agents": {
          "sisyphus": {
            "prompt_append": "file://__OMO_PROFILE_ROOT__/opencode/prompts/sisyphus-orchestration.md"
          }
        },
        "disabled_agents": ["forja"],
        "websearch": { "provider": "tavily" },
        "disabled_mcps": ["context7"],
        "browser_automation_engine": { "provider": "playwright" },
        "hashline_edit": true,
        "goal": {
          "enabled": true,
          "auto_start": false,
          "default_max_iterations": 100
        },
        "default_mode": {
          "goal": false,
          "ultrawork": true
        },
        "disabled_skills": ["dev-browser", "ultimate-browsing"],
        "disabled_hooks": [],
        "team_mode": {
          "enabled": true,
          "tmux_visualization": false,
          "max_parallel_members": 4,
          "max_members": 8
        }
      }
    }
  }
}
